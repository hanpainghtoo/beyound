# Internal Core API address used by Next.js server-side requests
# and same-origin proxy handlers.
CORE_API_URL=http://127.0.0.1:6001/api/v1

# Public WebSocket host.
# Do not include /api/v1 unless the WebSocket gateway explicitly
# listens under that path.
WS_BASE_URL=http://localhost:6001  

# Public Platform Console URL.
PLATFORM_CONSOLE_URL=https://admin.zayos.com.mm

