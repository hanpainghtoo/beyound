# ============================================================
# ZayOS Production Environment
# ============================================================

NODE_ENV=development

# Never use automatic schema synchronization in production.
DB_SYNCHRONIZE=false

# Keep false during normal production operation.
# Temporarily enable only when intentionally running the
# controlled production bootstrap/seed command.
ALLOW_PRODUCTION_SEED=true
ALLOW_DEMO_SEED_IN_PRODUCTION=true
ALLOW_DB_RESET=true
# ============================================================
# Database — PostgreSQL
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=batman
DB_PASSWORD=<%hph11011%>
DB_NAME=kme_omnichannel

# ============================================================
# Redis
# ============================================================

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Add only if Redis authentication is enabled.
# REDIS_PASSWORD=REPLACE_WITH_REDIS_PASSWORD


# ============================================================
# Authentication and Security
# ============================================================

JWT_SECRET=s3cr3t_prod_Km3_9988770011223355
