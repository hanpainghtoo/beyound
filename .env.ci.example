# Safe, non-secret CI defaults for deterministic local gates.
# CI may override any value through the workflow environment.

NODE_ENV=production

# Core API / database / Redis
PORT=6001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=zayos_ci
DB_SYNCHRONIZE=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Secrets are placeholders but satisfy production validation length rules.
JWT_SECRET=ci-jwt-secret-value-with-at-least-32-characters
JWT_REFRESH_SECRET=ci-refresh-secret-value-with-at-least-32-characters
INTERNAL_SERVICE_TOKEN_ISSUER=zayos-ci-internal-services
INTERNAL_SERVICE_TOKEN_SIGNING_KEY=ci-internal-service-token-signing-key-32-plus-chars
INTERNAL_SERVICE_TOKEN_TTL_SECONDS=300
INTERNAL_SERVICE_ALLOWED_CLOCK_SKEW_SECONDS=30
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=ci-provider-credential-key-32-characters
LOCAL_STORAGE_SIGNING_SECRET=ci-local-storage-signing-key-32-characters

# Browser-facing and server-side application URLs
CORE_API_URL=http://127.0.0.1:6001/api/v1
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:6100
NEXT_PUBLIC_WORKSPACE_URL=http://127.0.0.1:6100
NEXT_PUBLIC_PLATFORM_CONSOLE_URL=http://127.0.0.1:6101
NEXT_PUBLIC_META_APP_ID=123456789012345
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=ci-tiktok-client-key
WS_BASE_URL=ws://127.0.0.1:6001
WORKSPACE_URL=http://127.0.0.1:6100
PLATFORM_CONSOLE_URL=http://127.0.0.1:6101
META_APP_ID=123456789012345
META_APP_SECRET=ci-meta-app-secret-with-32-characters
TIKTOK_CLIENT_KEY=ci-tiktok-client-key
WORKSPACE_PUBLIC_APP_URL=https://workspace.ci.zayos.test
PLATFORM_CONSOLE_PUBLIC_APP_URL=https://platform-console.ci.zayos.test
FRONTEND_URLS=http://127.0.0.1:6100,http://127.0.0.1:6101,http://localhost:6100,http://localhost:6101
CORS_ORIGIN=http://127.0.0.1:6100,http://127.0.0.1:6101

# Sidecar service URLs
CHAT_INGESTION_URL=http://127.0.0.1:6002
WEBHOOK_HANDLER_URL=http://127.0.0.1:6003
INTEGRATION_SERVICE_URL=http://127.0.0.1:6004
FILE_STORAGE_URL=http://127.0.0.1:6005
FILE_STORAGE_PUBLIC_URL=http://127.0.0.1:6005
MEDIA_PROCESSING_URL=http://127.0.0.1:6006
WEBHOOK_PUBLIC_BASE_URL=https://webhooks.ci.zayos.test

# Telegram managed merchant-bot onboarding
TELEGRAM_MANAGER_BOT_TOKEN=123456789:ciTelegramManagerTokenValue000000
TELEGRAM_MANAGER_BOT_USERNAME=ZayOSManagerBot
TELEGRAM_MANAGER_WEBHOOK_SECRET=ci-telegram-manager-webhook-secret-32-chars
TELEGRAM_MANAGER_WEBHOOK_URL=https://webhooks.ci.zayos.test/webhooks/telegram/manager
TELEGRAM_MERCHANT_WEBHOOK_BASE_URL=https://webhooks.ci.zayos.test
TELEGRAM_TOKEN_ENCRYPTION_KEY=ci-telegram-token-encryption-key-32-chars
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40

# Provider/test placeholders
STORAGE_DRIVER=local-contract
META_PROVIDER_APP_ROUTING_ID=ci-meta-provider-route
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=ci-meta-webhook-verify-token
META_APP_STATUS=development_only
MESSENGER_GRAPH_API_BASE_URL=https://graph.facebook.com
MESSENGER_GRAPH_API_VERSION=v20.0
MESSENGER_VERIFY_TOKEN=ci-messenger-verify-token
MESSENGER_APP_SECRET=ci-messenger-app-secret-with-32-characters
TIKTOK_CLIENT_SECRET=ci-tiktok-client-secret-with-32-characters
VIBER_AUTH_TOKEN=ci-viber-auth-token-with-32-characters
VIBER_API_BASE_URL=https://chatapi.viber.com/pa
WEBHOOK_QUEUE_BACKEND=redis
ALLOW_PRODUCTION_SEED=true
ALLOW_DEMO_SEED_IN_PRODUCTION=true
