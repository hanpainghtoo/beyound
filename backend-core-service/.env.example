# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=zayos

# JWT Configuration
JWT_SECRET=dev-only-jwt-secret-change-this-value-123!
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-this-123!
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Cache Configuration
CACHE_TTL=300

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20
WEBHOOK_RATE_LIMIT=600
WEBHOOK_RATE_LIMIT_WINDOW_MS=60000

# Application Configuration
NODE_ENV=development
DB_SYNCHRONIZE=true
PORT=3001
FRONTEND_URLS=http://localhost:6100,http://localhost:6101
INTERNAL_SERVICE_TOKEN_ISSUER=zayos-local-internal-services
INTERNAL_SERVICE_TOKEN_SIGNING_KEY=dev-only-internal-service-token-signing-key-32-chars
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=dev-only-provider-key-change-this-123!
WORKSPACE_PUBLIC_APP_URL=http://localhost:6100
PLATFORM_CONSOLE_PUBLIC_APP_URL=http://localhost:6101
WEBHOOK_PUBLIC_BASE_URL=http://localhost:3001

# File Upload Configuration
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads
LOCAL_STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-123!

# Email Configuration (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zayos.com.mm

# Paid subscription-period quota/capacity enforcement is permanent and is
# enabled by the application. The historical
# SUBSCRIPTION_PERIOD_ENFORCEMENT_ENABLED variable is obsolete and ignored;
# do not use it as a rollout or rollback switch.
# Optional compatibility evidence dual-write (default enabled):
# SUBSCRIPTION_PERIOD_SHADOW_DUAL_WRITE=false

# Production bootstrap only
PRODUCTION_PLATFORM_ADMIN_FULL_NAME=Launch Admin
PRODUCTION_PLATFORM_ADMIN_EMAIL=admin@zayos.com.mm
PRODUCTION_PLATFORM_ADMIN_PASSWORD=Change-this-prod-admin-password-123!
