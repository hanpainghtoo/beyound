{
  "name": "zayos-core-service",
  "description": "Core API service for Commerce OS",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "ts-node src/main.ts",
    "start:outbound-worker": "node dist/outbound-worker",
    "start:outbound-worker:dev": "ts-node src/outbound-worker.ts",
    "start:prod": "node dist/main",
    "seed": "ts-node src/database/seed.ts",
    "seed:period-snapshot-backfill": "ts-node src/database/seed-period-snapshot-backfill.ts",
    "seed:demo": "node dist/database/seed.js",
    "seed:prod": "node dist/database/seed-prod.js",
    "backfill:subscription-periods": "ts-node src/database/backfill-subscription-periods.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:show": "npm run typeorm -- migration:show",
    "smoke:api": "node scripts/api-smoke.js",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/cache-manager": "latest",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/jwt": "latest",
    "@nestjs/passport": "latest",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.4.6",
    "@nestjs/throttler": "latest",
    "@nestjs/typeorm": "latest",
    "@nestjs/websockets": "^11.1.28",
    "@zayos/internal-service-auth": "file:../packages/internal-service-auth",
    "bcryptjs": "latest",
    "cache-manager": "latest",
    "class-transformer": "latest",
    "class-validator": "latest",
    "express": "^5.2.1",
    "jws": "^3.2.3",
    "keyv": "latest",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "passport": "latest",
    "passport-jwt": "latest",
    "passport-local": "latest",
    "pg": "latest",
    "reflect-metadata": "latest",
    "rxjs": "latest",
    "socket.io": "^4.8.3",
    "typeorm": "^0.3.31",
    "validator": "^13.15.35",
    "winston": "latest",
    "winston-daily-rotate-file": "latest",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/testing": "^11.1.28",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^24",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "latest",
    "@types/passport-local": "latest",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
