# ============================================================
# ZayOS Local Dev Environment template (build-file runtime)
# Used by: ZAYOS_ENV=dev npm run pm2:start
# NODE_ENV=development is applied by ecosystem.config.js.
#
# Setup:
#   cp .env.dev.example .env.dev
#   Then fill in your real local values (DB password, Telegram bot,
#   ngrok webhook URL, SMTP, provider secrets).
#
# .env.dev is gitignored. Keep real secrets out of this template.
# ============================================================

# Database — PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=password
DB_NAME=zayos
DB_SYNCHRONIZE=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication and Security
JWT_SECRET=dev-only-jwt-secret-change-this-value-123!
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-this-123!
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12
INTERNAL_API_KEY=dev-only-internal-api-key-change-this-123!
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=dev-only-provider-key-change-this-123!

# Authentication Rate Limits
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REGISTER_RATE_LIMIT=5
AUTH_REFRESH_RATE_LIMIT=20

# Public Origins and CORS
FRONTEND_URLS=http://localhost:6100,http://localhost:6101
CORS_ORIGIN=http://localhost:6100,http://localhost:6101

# Browser-facing and server-side application URLs
NEXT_PUBLIC_API_BASE_URL=http://localhost:6001/api/v1
NEXT_PUBLIC_SITE_URL=http://localhost:6100
NEXT_PUBLIC_PLATFORM_CONSOLE_URL=http://localhost:6101
NEXT_PUBLIC_META_APP_ID=123456789012345
NEXT_PUBLIC_TIKTOK_CLIENT_KEY=dev-tiktok-client-key
CORE_API_URL=http://localhost:6001/api/v1
WS_BASE_URL=http://localhost:6001
WORKSPACE_URL=http://localhost:6100
PLATFORM_CONSOLE_URL=http://localhost:6101

# Public Application URLs
WORKSPACE_PUBLIC_APP_URL=http://localhost:6100
PLATFORM_CONSOLE_PUBLIC_APP_URL=http://localhost:6101
WEBHOOK_PUBLIC_BASE_URL=https://your-ngrok-url.ngrok-free.dev
FILE_STORAGE_PUBLIC_URL=http://localhost:6005

# Internal Service Authentication
INTERNAL_SERVICE_TOKEN_ISSUER=zayos-local-internal-services
INTERNAL_SERVICE_TOKEN_SIGNING_KEY=dev-only-internal-service-token-signing-key-32-chars
INTERNAL_SERVICE_TOKEN_TTL_SECONDS=300
INTERNAL_SERVICE_ALLOWED_CLOCK_SKEW_SECONDS=30

# File Storage
STORAGE_DRIVER=local-disk
LOCAL_STORAGE_SIGNING_SECRET=dev-only-storage-signing-secret-123!
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Webhook Queue
WEBHOOK_QUEUE_BACKEND=redis

# Sidecar Service URLs
CHAT_INGESTION_URL=http://localhost:6002
WEBHOOK_HANDLER_URL=http://localhost:6003
INTEGRATION_SERVICE_URL=http://localhost:6004
FILE_STORAGE_URL=http://localhost:6005
MEDIA_PROCESSING_URL=http://localhost:6006

# Telegram managed merchant-bot onboarding
TELEGRAM_MANAGER_BOT_TOKEN=123456789:devTelegramTokenValue000000
TELEGRAM_MANAGER_BOT_USERNAME=ZayOSManagerBot
TELEGRAM_MANAGER_WEBHOOK_SECRET=dev-telegram-manager-webhook-secret-32-chars
TELEGRAM_MANAGER_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.dev/webhooks/telegram/manager
TELEGRAM_MERCHANT_WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok-free.dev
TELEGRAM_TOKEN_ENCRYPTION_KEY=dev-telegram-token-encryption-key-32-chars
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_WEBHOOK_MAX_CONNECTIONS=40

# Provider/test values
META_APP_ID=123456789012345
META_APP_SECRET=dev-meta-app-secret-with-32-characters
META_PROVIDER_APP_ROUTING_ID=dev-meta-provider-route
META_GRAPH_API_VERSION=v25.0
META_WEBHOOK_VERIFY_TOKEN=dev-meta-webhook-verify-token
META_APP_STATUS=development_only
MESSENGER_GRAPH_API_BASE_URL=https://graph.facebook.com
MESSENGER_GRAPH_API_VERSION=v25.0
MESSENGER_VERIFY_TOKEN=dev-messenger-verify-token
MESSENGER_APP_SECRET=dev-messenger-app-secret-with-32-characters
TIKTOK_CLIENT_KEY=dev-tiktok-client-key
TIKTOK_CLIENT_SECRET=dev-tiktok-client-secret-with-32-characters
VIBER_AUTH_TOKEN=dev-viber-auth-token-with-32-characters
VIBER_API_BASE_URL=https://chatapi.viber.com/pa

# Email (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@zayos.com.mm

# Media processing providers (leave unset for local default behavior)
# FILE_SCANNING_PROVIDER=
# FILE_SCANNING_ENDPOINT=
# FILE_SCANNING_API_KEY=
# TRANSCRIPTION_PROVIDER=
# TRANSCRIPTION_ENDPOINT=
# TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_MODEL=
