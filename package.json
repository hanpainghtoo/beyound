{
  "name": "zayos-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace scripts for ZayOS Phase 1 verification",
  "scripts": {
    "build": "npm run build:backend && npm run build:dashboards && npm run build:services",
    "build:backend": "npm --prefix backend-core-service run build",
    "dev:backend": "npm --prefix backend-core-service run start:dev",
    "dev:workspace": "npm --prefix dashboards/workspace run dev:wait",
    "dev:platform-console": "npm --prefix dashboards/platform-console run dev:wait",
    "test:backend": "npm --prefix backend-core-service test -- --runInBand",
    "test:integration:db:up": "docker compose -f docker-compose.test.yml up -d --wait postgres-test",
    "test:integration:db:down": "docker compose -f docker-compose.test.yml down -v",
    "test:integration": "npm run test:integration:db:up && TEST_DATABASE_URL=postgresql://zayos_test:zayos_test@127.0.0.1:55432/zayos_commerce_test npm --prefix backend-core-service run test:integration; status=$?; npm run test:integration:db:down; exit $status",
    "build:dashboards": "npm --prefix dashboards/workspace run build && npm --prefix dashboards/platform-console run build",
    "build:services": "npm --prefix services/chat-ingestion-service run build && npm --prefix services/webhook-handler-service run build && npm --prefix services/integration-service run build && npm --prefix services/file-storage-service run build && npm --prefix services/media-processing-service run build",
    "db:migration:update": "npm --prefix backend-core-service run migration:run",
    "db:migration:show": "npm --prefix backend-core-service run migration:show",
    "db:migration:revert": "npm --prefix backend-core-service run migration:revert",
    "test:e2e:workspace": "npm --prefix dashboards/workspace run test:e2e",
    "test:e2e:platform-console": "npm --prefix dashboards/platform-console run test:e2e",
    "test:e2e": "npm run test:e2e:workspace && npm run test:e2e:platform-console",
    "test:config": "node --test test/production-runtime-config.test.mjs",
    "seed:demo": "bash scripts/seed-demo.sh",
    "seed:inbox-volume": "bash scripts/seed-inbox-volume.sh",
    "smoke:api": "npm --prefix backend-core-service run smoke:api",
    "smoke:providers": "node scripts/provider-credential-smoke.mjs",
    "telegram:shop:set": "npm --prefix backend-core-service run telegram:shop:set --",
    "db:backup": "bash scripts/db-backup.sh",
    "db:reset": "bash scripts/db-reset.sh",
    "db:reset:demo": "bash scripts/db-reset-demo.sh",
    "db:restore": "bash scripts/db-restore.sh",
    "pm2:dev:start": "pm2 start ecosystem.dev.config.js",
    "pm2:dev:restart": "pm2 restart ecosystem.dev.config.js --update-env",
    "pm2:dev:stop": "pm2 stop ecosystem.dev.config.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:restart": "pm2 restart ecosystem.config.js --update-env",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs",
    "ci:config": "node scripts/ci-run.mjs config",
    "ci:typecheck": "node scripts/ci-run.mjs typecheck",
    "ci:lint": "node scripts/ci-run.mjs lint",
    "ci:test": "node scripts/ci-run.mjs test",
    "ci:integration": "node scripts/ci-run.mjs integration",
    "ci:build": "node scripts/ci-run.mjs build",
    "ci:browser": "node scripts/ci-run.mjs browser",
    "ci:audit": "node scripts/ci-run.mjs audit",
    "ci:phase1": "node scripts/ci-run.mjs phase1",
    "ci:full": "node scripts/ci-run.mjs full"
  }
}
